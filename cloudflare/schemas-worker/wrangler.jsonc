{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schemas-worker",
  "compatibility_date": "2026-10-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "schemas.vik.guru",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
