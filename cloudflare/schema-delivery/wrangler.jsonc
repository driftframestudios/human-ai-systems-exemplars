{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "human-ai-systems-schema-delivery",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "release": {
      "workers_dev": false,
      "routes": []
    }
  }
}
