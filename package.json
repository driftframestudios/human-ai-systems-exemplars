{
  "name": "human-ai-systems-exemplars",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "playwright:install": "playwright install chromium",
    "build:public-references": "node tools/materialize-public-references.mjs",
    "build:iframe-routes": "node tools/package-v1-iframe-routes.mjs",
    "check:iframe-routes": "node tools/package-v1-iframe-routes.mjs --check",
    "build:schema-pages": "node tools/build-schema-pages.mjs",
    "build:schema-delivery": "node cloudflare/schema-delivery/build.mjs",
    "check:schema-delivery": "node cloudflare/schema-delivery/build.mjs --check",
    "dry-run:schema-delivery": "npm run build:schema-delivery && wrangler deploy --dry-run --env=\"\" --config cloudflare/schema-delivery/wrangler.jsonc",
    "dry-run:schema-delivery:release": "npm run build:schema-delivery && wrangler deploy --dry-run --env release --config cloudflare/schema-delivery/wrangler.jsonc",
    "deploy:schema-delivery:release": "npm run build:schema-delivery && wrangler deploy --strict --env release --config cloudflare/schema-delivery/wrangler.jsonc",
    "deploy:schema-delivery:prod": "npm run build:schema-delivery && wrangler deploy --strict --env=\"\" --config cloudflare/schema-delivery/wrangler.jsonc",
    "check:schemas": "node tools/check-schema-surface.mjs",
    "check:research-projection": "node tools/research-projection-receipt.mjs",
    "security:secrets": "node tools/scan-secret-material.mjs all",
    "security:secrets:install": "node tools/install-betterleaks.mjs",
    "security:secrets:canary": "node tools/scan-secret-material.mjs canary",
    "security:secrets:tree": "node tools/scan-secret-material.mjs tree",
    "security:secrets:staged": "node tools/scan-secret-material.mjs staged",
    "security:secrets:history": "node tools/scan-secret-material.mjs history",
    "security:secrets:artifact": "node tools/scan-secret-material.mjs artifact",
    "security:secrets:public-references": "node tools/scan-secret-material.mjs artifact .public-reference-build/context-canvas-project-surface",
    "test:open-lesson-field": "node tools/open-lesson-field-contract.mjs",
    "test:public-reference-materializer": "node --test tests/public-references/materializer.test.mjs",
    "test:context-canvas": "node --test tests/context-canvas/*.test.mjs",
    "test:attribution": "node --test tests/attribution/*.test.mjs tests/context-canvas/visitor-surface-attribution.test.mjs",
    "test:iframe-routes": "node --test tests/iframe-routes/*.test.mjs",
    "test:canvas-iframe-routes": "npm run build:iframe-routes && node tools/canvas-iframe-route-browser-contract.mjs",
    "test:iframe-browser": "node tools/core-iframe-carrier-contract.mjs && npm run test:canvas-iframe-routes",
    "test:secret-material": "node --test tests/security/secret-material.test.mjs",
    "test:strategy-canvas": "node tools/strategy-canvas-contract.mjs",
    "test:core-decision-canvases": "node tools/core-decision-canvas-contract.mjs",
    "test:core-planning-instruments": "node tools/core-planning-instrument-contract.mjs",
    "test:core-reference-instruments": "node tools/core-reference-instrument-contract.mjs",
    "test:core-browser": "npm run test:core-decision-canvases && npm run test:core-planning-instruments && npm run test:core-reference-instruments && npm run test:iframe-carriers",
    "test:iframe-carriers": "node --test tests/context-canvas/iframe-carriers.test.mjs && node tools/core-iframe-carrier-contract.mjs",
    "test:core-architectures": "node --test tests/core-architectures/*.test.mjs",
    "test:narrative-architectures": "node --test tests/narrative-architectures/*.test.mjs",
    "test:narrative-browser": "node tools/narrative-architecture-contract.mjs",
    "test:prototype-exchanges": "node tools/cross-prototype-exchange-contract.mjs",
    "test:prototype-units": "npm run test:core-architectures && npm run test:narrative-architectures",
    "build:strategy-canvas-consumer-bundles": "node tools/strategy-canvas-consumer-bundles.mjs",
    "check:strategy-canvas-consumer-bundles": "node tools/strategy-canvas-consumer-bundles.mjs --check",
    "visual:check": "node tools/visual-check.mjs",
    "visual:context-canvas-reference": "node tools/context-canvas-visual-reference.mjs",
    "visual:conditioning-field": "node tools/visual-check.mjs context-canvas-project-surface/context-canvas/conditioning-field.html --name conditioning-field --selector .ladder-table --open-details",
    "visual:ai-systems-conditioning": "node tools/visual-check.mjs context-canvas-project-surface/context-canvas/ai-systems.html --name ai-systems-conditioning-embed --selector .ai-systems-conditioning-lab --http --iframe-selector \"iframe[title='Interactive Conditioning Field prompt formulation, repair, and human-referent surface']\" --iframe-content-selector \"#mainContent\"",
    "visual:open-lesson-field": "node tools/visual-check.mjs collaboration/open-lesson-field/index.html --name open-lesson-field --selector \"#scatterplot\" --http --wide --readable-control-selector \"#grade\" --readable-control-selector \"#learners\" --readable-control-selector \"#minutes\" --readable-control-selector \"#request-input\" --readable-control-selector \"#proxy\" --readable-control-selector \"#receiver\"",
    "visual:prompt-side-practice": "node tools/visual-check.mjs context-canvas-project-surface/context-canvas/prompt-side-conditions-practice.html --name prompt-side-practice --selector .prompt-comparison --http --wide --iframe-selector \"iframe[title='Open Lesson Field educator collaboration instrument']\" --iframe-content-selector \"#main\"",
    "visual:initiative-costing": "node tools/visual-check.mjs collaboration/initiative-costing-calculator/index.html --name initiative-costing-ledger --selector .workspace --readable-control-selector \".ledger-row input[data-field='name']\"",
    "visual:rail-labels": "node tools/visual-check.mjs context-canvas-project-surface/context-canvas/conditioning-field.html --name context-canvas-rail-labels --selector .page-section-rail --rail-label-check",
    "visual:debriefs-rail": "node tools/visual-check.mjs context-canvas-project-surface/context-canvas/debriefs.html --name debriefs-source-rail --selector .page-section-rail --rail-label-check --http",
    "visual:strategy-canvas-canonical": "node tools/visual-check.mjs core-architectures-chimeric-prototype-current-pack-v0.1/strategy-canvas-chimeric-prototype-v0.2.2.html --name strategy-canvas-canonical --selector \"#strategy-canvas-chart\" --http --wide",
    "visual:strategy-canvas-context": "node tools/visual-check.mjs context-canvas-project-surface/context-canvas/prototypes/core-architectures/chimeric-pack-v0.1/strategy-canvas-chimeric-prototype-v0.2.2.html --name strategy-canvas-context --selector \"#strategy-field\" --http --wide",
    "build:context-canvas-field-pilot": "node cloudflare/context-canvas-field-pilot/build.mjs",
    "check:context-canvas-field-pilot": "node cloudflare/context-canvas-field-pilot/build.mjs --check",
    "dry-run:context-canvas-field-pilot": "npm run build:context-canvas-field-pilot && wrangler deploy --dry-run --config cloudflare/context-canvas-field-pilot/wrangler.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "wrangler": "4.125.0"
  }
}
