{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftframe.studio/schemas/solution-architecture-machine-node-v2.1.json",
  "title": "Solution Architecture Lab Machine Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@id",
    "schema_version",
    "type",
    "name",
    "parent_ref",
    "hands_to",
    "version_band",
    "status",
    "contract",
    "source_fragments",
    "campaigns",
    "negation_aware",
    "temporal_layers",
    "evidence_classes",
    "execution_classes",
    "execution_class",
    "execution_scope",
    "qualification_stage",
    "artifact_class",
    "verification_status",
    "receipts",
    "open_receipts",
    "affected_populations",
    "regulatory_scope",
    "last_reviewed",
    "last_stabilized",
    "supersedes",
    "superseded_by",
    "github"
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "environment", "observed_at", "result", "locator", "supports"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "supports": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "@id": {"type": "string", "pattern": "^@driftframe/"},
    "schema_version": {"const": "2.0"},
    "type": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "parent_ref": {
      "type": "string",
      "format": "uri-reference",
      "description": "Absolute URI, stable URN, or repository-relative source reference."
    },
    "hands_to": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference",
        "description": "Absolute or repository-relative receiving artifact reference."
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "version_band": {"type": "string", "pattern": "^20[0-9]{2}\\.[0-9]{2}$"},
    "status": {"type": "string", "minLength": 1},
    "contract": {"type": "string", "minLength": 1},
    "source_fragments": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference",
        "description": "Absolute URI, stable URN, or repository-relative source reference."
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "campaigns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "negation_aware": {"const": true},
    "temporal_layers": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "evidence_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "execution_classes": {
      "type": "array",
      "items": {
        "enum": [
          "not_applicable",
          "illustrative_pseudocode",
          "illustrative_compilable",
          "tested_excerpt",
          "verified_running"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "execution_class": {
      "enum": [
        "not_applicable",
        "illustrative_pseudocode",
        "illustrative_compilable",
        "tested_excerpt",
        "verified_running"
      ]
    },
    "execution_scope": {"type": "string", "minLength": 1},
    "qualification_stage": {"type": "string", "minLength": 1},
    "artifact_class": {"type": "string", "minLength": 1},
    "verification_status": {"type": "string", "minLength": 1},
    "receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}, "minItems": 1},
    "open_receipts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "affected_populations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "regulatory_scope": {"type": "string", "minLength": 20},
    "last_reviewed": {"type": "string", "format": "date"},
    "last_stabilized": {"type": "string", "format": "date"},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "reference_path", "merge_target", "branch_name", "branch_url", "commit_sha", "pull_request_url"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "reference_path": {"type": "string", "minLength": 1},
        "merge_target": {"const": "main"},
        "branch_name": {"type": "string", "minLength": 1},
        "branch_url": {"type": "string", "format": "uri"},
        "commit_sha": {"type": "string", "minLength": 1},
        "pull_request_url": {"type": "string", "minLength": 1}
      }
    }
  }
}
