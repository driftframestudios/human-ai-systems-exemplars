{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftframe.studio/schemas/lims-eln-data-primitive-ledger-v1.json",
  "title": "LIMS/ELN data primitive finding ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledgerId", "schemaVersion", "reviewedAt", "scope", "severityPolicy", "findings"],
  "properties": {
    "ledgerId": {"type": "string", "minLength": 1},
    "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "severityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium"],
      "properties": {
        "critical": {"type": "string", "minLength": 1},
        "high": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1}
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "coordinate", "currentPrimitive", "materialEffect", "desiredState", "disposition", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^DB-[0-9]{3}$"},
          "severity": {"enum": ["critical", "high", "medium"]},
          "coordinate": {"type": "string", "minLength": 1},
          "currentPrimitive": {"type": "string", "minLength": 1},
          "materialEffect": {"type": "string", "minLength": 1},
          "desiredState": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "verification": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        }
      }
    }
  }
}
