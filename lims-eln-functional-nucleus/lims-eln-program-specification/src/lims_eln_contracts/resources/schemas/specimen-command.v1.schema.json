{
  "$defs": {
    "JsonValue": {},
    "SpecimenCommandAction": {
      "enum": [
        "register",
        "accession",
        "start_processing",
        "submit_review",
        "release",
        "correct",
        "void"
      ],
      "title": "SpecimenCommandAction",
      "type": "string"
    }
  },
  "$id": "urn:driftframe:lims-eln:specimen-command:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/SpecimenCommandAction"
    },
    "actor_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
      "title": "Actor Id",
      "type": "string"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
      "title": "Command Id",
      "type": "string"
    },
    "expected_version": {
      "minimum": 0,
      "title": "Expected Version",
      "type": "integer"
    },
    "occurred_at": {
      "maxLength": 27,
      "minLength": 20,
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "reason_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string"
    },
    "specimen_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
      "title": "Specimen Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "tenant_id",
    "specimen_id",
    "actor_id",
    "action",
    "expected_version",
    "occurred_at"
  ],
  "title": "SpecimenCommand",
  "type": "object"
}
