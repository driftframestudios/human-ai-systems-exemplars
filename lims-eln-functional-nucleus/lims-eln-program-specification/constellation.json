{
  "constellation_id": "lims-eln-open-receipts",
  "version": "0.3.1",
  "repositories": [
    {
      "role": "program",
      "repository": "urn:source-key:lims-eln-program-specification",
      "authority": "intent_examples_decisions_acceptance"
    },
    {
      "role": "actual",
      "repository": "urn:source-key:lims-eln-enterprise-implementation",
      "authority": "active_code_and_observed_execution"
    },
    {
      "role": "simulation",
      "repository": "urn:source-key:lims-eln-simulated-final-state",
      "authority": "executable_counterfactual"
    },
    {
      "role": "comparison",
      "repository": "urn:source-key:lims-eln-comparative-evidence",
      "authority": "paired_runs_and_redacted_evidence"
    },
    {
      "role": "governance",
      "repository": "urn:source-key:site-reading-governance",
      "authority": "shared_schemas_workflows_templates_rulesets"
    }
  ],
  "dependency_rule": "program releases flow to both implementations; comparison consumes pinned releases",
  "learning_rule": "adjudicated differences create successor decisions and forecasts"
}
