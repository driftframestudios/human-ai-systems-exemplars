  "na:methodologicalGap": [
    {
      "@id": "vs:gap/calibration-absent",
      "@type": "na:MethodologicalGap",
      "na:gapType": "calibration_absent",
      "schema:description": "The probabilities are planning estimates and have no empirical calibration against future naming outcomes.",
      "na:gapUtility": "coordination_gap",
      "na:routeTargetRef": {
        "@id": "ra:research-atlas"
      }
    },
    {
      "@id": "vs:gap/human-vocabulary",
      "@type": "na:MethodologicalGap",
      "na:gapType": "human_vocabulary_gap",
      "schema:description": "Different readers may lack the disciplinary vocabulary needed to interpret rare canonical terms.",
      "na:gapUtility": "coordination_gap",
      "na:routeTargetRef": {
        "@id": "ca:context-tree"
      }
    },
    {
      "@id": "vs:gap/collision-review",
      "@type": "na:MethodologicalGap",
      "na:gapType": "legal_or_collision_review",
