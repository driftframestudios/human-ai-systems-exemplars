    {
      "@id": "https://schemas.driftframestudios.org/na/examples/technology-fit-prompt-capsule-v0.1",
      "@type": "AIContextProjection",
      "name": "Technology fit sampling request",
      "description": "Choose two front-end stack candidates for equivalent low-fidelity spikes, then preserve evidence and an exit path before a durable stack commitment.",
      "probabilityObject": [
        {
          "@id": "https://schemas.driftframestudios.org/na/examples/probability-default-likelihood",
          "@type": "ProbabilityDefinition",
          "name": "Generic LLM first-recommendation likelihood",
          "description": "P(generic-LLM-first-recommendation | the named prompt condition): the model-verbalized probability that a candidate appears as the first recommendation under that request.",
          "candidateSetSemantics": "open_exclusive",
          "measurementStatus": "illustrative_verbalized_sample"
        },
        {
          "@id": "https://schemas.driftframestudios.org/na/examples/probability-six-month-fit",
          "@type": "ProbabilityDefinition",
          "name": "Six-month collaboration fit",
          "description": "P(six-month-fit-without-structural-rewrite | declared outcome, team conditions, and current evidence): the contextual planning probability that a candidate supports the selected low-fidelity interaction surfaces for six months while preserving accessibility, semantic readability, maintainability, testability, and a practical replacement path.",
          "candidateSetSemantics": "independent_events",
          "measurementStatus": "illustrative_planning_estimate"
        }
      ]
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/human-maintainability",
      "@type": "FitDimension",
      "name": "Human maintainability",
      "description": "How readily maintainers can understand ownership, debug behavior, and make local changes after the initial implementation.",
      "weight": 0.18
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/accessibility-integrity",
      "@type": "FitDimension",
      "name": "Accessibility integrity",
      "description": "How reliably the stack preserves native semantics, keyboard behavior, accessible naming, status feedback, and local assistive-technology verification.",
      "weight": 0.17
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/swapability",
      "@type": "FitDimension",
      "name": "Swapability",
      "description": "How clearly rendering, styling, components, state, and build layers can be replaced without rewriting unrelated behavior.",
      "weight": 0.15
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/iteration-speed",
      "@type": "FitDimension",
      "name": "Low-fidelity iteration speed",
      "description": "How quickly collaborators can produce, inspect, and revise credible low-fidelity surfaces.",
      "weight": 0.12
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/ai-legibility",
      "@type": "FitDimension",
      "name": "AI collaboration legibility",
      "description": "How well code structure, contracts, examples, and failure states support accurate AI modification and explanation.",
      "weight": 0.11
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/svg-control",
      "@type": "FitDimension",
      "name": "SVG and data-visual control",
      "description": "How directly collaborators can control coordinate systems, grouping, transforms, label placement, interaction, and accessible equivalents.",
      "weight": 0.1
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/testability",
      "@type": "FitDimension",
      "name": "Testability and specification fit",
      "description": "How easily behavior can be specified independently, tested across layers, and preserved during replacement.",
      "weight": 0.09
    },
    {
      "@id": "https://schemas.driftframestudios.org/na/examples/dimension/operational-calm",
      "@type": "FitDimension",
      "name": "Operational and dependency calm",
      "description": "How well the stack bounds dependency churn, build complexity, resource lifetimes, static deployment, and observability.",
      "weight": 0.08
    },
