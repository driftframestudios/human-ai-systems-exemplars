{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vik.guru/visual-fidelity-contracts/1.0.0/public-lineage.schema.json",
  "title": "Visual Fidelity Public Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "reviewedOn", "records"],
  "properties": {
    "$schema": {
      "const": "https://schemas.vik.guru/visual-fidelity-contracts/1.0.0/public-lineage.schema.json"
    },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "vfc:public-lineage" },
    "reviewedOn": { "type": "string", "format": "date" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "repositorySource",
        "publicRoute",
        "relationship",
        "semanticOwner",
        "publicationOwner",
        "standing",
        "privateLineagePolicy",
        "reentry"
      ],
      "properties": {
        "contractId": { "type": "string", "pattern": "^vfc:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "repositorySource": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/ -]*$"
        },
        "publicRoute": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://kindlight\\.systems/"
        },
        "relationship": { "enum": ["projects", "references", "snapshots"] },
        "semanticOwner": { "type": "string", "minLength": 3, "maxLength": 120 },
        "publicationOwner": { "type": "string", "minLength": 3, "maxLength": 120 },
        "standing": { "enum": ["verified_public_route", "publication_candidate", "superseded"] },
        "privateLineagePolicy": { "type": "string", "minLength": 12, "maxLength": 600 },
        "reentry": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 8, "maxLength": 300 } }
      }
    }
  }
}
