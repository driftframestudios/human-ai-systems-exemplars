{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vik.guru/visual-fidelity-contracts/1.0.0/visual-fidelity-contract.schema.json",
  "title": "Visual Fidelity Contract",
  "description": "A source-maintained contract for visual meaning, implementation behavior, receiving authority, and verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "title",
    "version",
    "standing",
    "kind",
    "reviewedOn",
    "publicRoute",
    "sourceAuthority",
    "purpose",
    "fit",
    "invariants",
    "permittedVariation",
    "tokens",
    "typography",
    "geometry",
    "behavior",
    "media",
    "evidence",
    "references"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.vik.guru/visual-fidelity-contracts/1.0.0/visual-fidelity-contract.schema.json"
    },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/contractId" },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "version": { "$ref": "#/$defs/semver" },
    "standing": {
      "enum": ["review_candidate", "established", "superseded", "retired"]
    },
    "kind": {
      "enum": ["art_direction_contract", "repository_composition_contract"]
    },
    "reviewedOn": { "type": "string", "format": "date" },
    "supersedes": {
      "type": "array",
      "items": { "$ref": "#/$defs/contractId" },
      "uniqueItems": true,
      "maxItems": 16
    },
    "publicRoute": { "$ref": "#/$defs/publicUrl" },
    "sourceAuthority": { "$ref": "#/$defs/sourceAuthority" },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plainLanguage", "populations", "jobs"],
      "properties": {
        "plainLanguage": { "$ref": "#/$defs/prose" },
        "populations": { "$ref": "#/$defs/nonEmptyProseList" },
        "jobs": { "$ref": "#/$defs/nonEmptyProseList" }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fits", "poorFits", "smallestUsefulDose"],
      "properties": {
        "fits": { "$ref": "#/$defs/nonEmptyProseList" },
        "poorFits": { "$ref": "#/$defs/nonEmptyProseList" },
        "smallestUsefulDose": { "$ref": "#/$defs/prose" }
      }
    },
    "invariants": { "$ref": "#/$defs/nonEmptyProseList" },
    "permittedVariation": { "$ref": "#/$defs/nonEmptyProseList" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "path", "paletteClosed", "colorPairs"],
      "properties": {
        "authority": { "enum": ["authoritative_input", "reference_mapping"] },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "paletteClosed": { "type": "boolean" },
        "colorPairs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/colorPair" }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "bodyMinimumRem", "metadataMinimumRem", "readingMeasureCh", "uses"],
      "properties": {
        "families": { "$ref": "#/$defs/nonEmptyProseList" },
        "bodyMinimumRem": { "type": "number", "minimum": 1 },
        "metadataMinimumRem": { "type": "number", "minimum": 0.75 },
        "readingMeasureCh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetMin", "targetMax", "absoluteMax"],
          "properties": {
            "targetMin": { "type": "integer", "minimum": 40, "maximum": 70 },
            "targetMax": { "type": "integer", "minimum": 50, "maximum": 75 },
            "absoluteMax": { "type": "integer", "minimum": 60, "maximum": 90 }
          }
        },
        "uses": { "$ref": "#/$defs/nonEmptyProseList" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cornerTreatment", "targetMinimumCssPx", "depth", "spacing"],
      "properties": {
        "cornerTreatment": { "enum": ["square", "near_square", "mixed", "rounded"] },
        "targetMinimumCssPx": { "type": "integer", "minimum": 44, "maximum": 80 },
        "depth": { "$ref": "#/$defs/prose" },
        "spacing": { "$ref": "#/$defs/prose" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "errorRecovery", "focus", "keyboard", "motion", "noJavaScript"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": {
            "enum": [
              "idle", "available", "hover", "focus", "selected", "disabled",
              "loading", "empty", "partial", "stale", "invalid", "error",
              "recovering", "recovered", "accepted", "held"
            ]
          },
          "uniqueItems": true
        },
        "errorRecovery": { "$ref": "#/$defs/nonEmptyProseList" },
        "focus": { "$ref": "#/$defs/prose" },
        "keyboard": { "$ref": "#/$defs/prose" },
        "motion": { "$ref": "#/$defs/prose" },
        "noJavaScript": { "$ref": "#/$defs/prose" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reflow320CssPx",
        "textResize200Percent",
        "print",
        "forcedColors",
        "reducedMotion",
        "svg",
        "imagery"
      ],
      "properties": {
        "reflow320CssPx": { "$ref": "#/$defs/prose" },
        "textResize200Percent": { "$ref": "#/$defs/prose" },
        "print": { "$ref": "#/$defs/prose" },
        "forcedColors": { "$ref": "#/$defs/prose" },
        "reducedMotion": { "$ref": "#/$defs/prose" },
        "svg": { "$ref": "#/$defs/prose" },
        "imagery": { "$ref": "#/$defs/prose" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standing", "establishes", "boundaries", "reentry"],
      "properties": {
        "standing": {
          "enum": ["repository_observation", "public_reference_synthesis", "validated_contract"]
        },
        "establishes": { "$ref": "#/$defs/nonEmptyProseList" },
        "boundaries": { "$ref": "#/$defs/nonEmptyProseList" },
        "reentry": { "$ref": "#/$defs/nonEmptyProseList" }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalExamples", "codeSamples", "tests"],
      "properties": {
        "canonicalExamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/reference" }
        },
        "codeSamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    }
  },
  "$defs": {
    "contractId": {
      "type": "string",
      "pattern": "^vfc:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "prose": { "type": "string", "minLength": 8, "maxLength": 1200 },
    "nonEmptyProseList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/prose" },
      "uniqueItems": true
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/ -]*$"
    },
    "publicUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://kindlight\\.systems/"
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticOwner", "schemaOwner", "publicationOwner", "sourcePath", "relationship"],
      "properties": {
        "semanticOwner": { "type": "string", "minLength": 3, "maxLength": 120 },
        "schemaOwner": { "type": "string", "minLength": 3, "maxLength": 120 },
        "publicationOwner": { "type": "string", "minLength": 3, "maxLength": 120 },
        "sourcePath": { "$ref": "#/$defs/repositoryPath" },
        "relationship": { "enum": ["authored_source", "repository_projection", "reviewed_snapshot"] }
      }
    },
    "colorPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "background", "minimumRatio", "uses"],
      "properties": {
        "foreground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "minimumRatio": { "type": "number", "minimum": 3, "maximum": 21 },
        "uses": { "$ref": "#/$defs/nonEmptyProseList" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path", "standing"],
      "properties": {
        "label": { "type": "string", "minLength": 3, "maxLength": 160 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "standing": { "enum": ["canonical", "reference", "adaptation"] }
      }
    }
  }
}
