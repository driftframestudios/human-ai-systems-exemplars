{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vik.guru/visual-fidelity/components-and-data-probe-catalog/v1.schema.json",
  "title": "Component and Data-View Probe Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogId", "revision", "claimBoundary", "probes"],
  "properties": {
    "$schema": { "const": "./probe-catalog.schema.json" },
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "visual-fidelity-components-and-data-probes" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "claimBoundary": { "type": "string", "minLength": 40, "maxLength": 500 },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "observable", "evidence", "sources", "tests"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
          "decision": { "type": "string", "minLength": 10, "maxLength": 240 },
          "observable": { "type": "string", "minLength": 20, "maxLength": 400 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["source", "schema", "fixture", "unit-transition", "boundary-test", "semantic-twin", "dom-contract", "browser-behavior"] }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\.\\./\\.\\./labs/[a-z0-9-]+/.+" }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\.\\./\\.\\./\\.\\./tests/visual-fidelity-contracts/.+" }
          }
        }
      }
    }
  }
}
