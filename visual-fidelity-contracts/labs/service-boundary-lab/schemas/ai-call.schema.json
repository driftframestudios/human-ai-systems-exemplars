{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vik.guru/visual-fidelity/service-boundary-ai-call.v1.schema.json",
  "title": "Visual Fidelity bounded AI call",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "sourceAuthority", "budget", "tools", "inputProjection", "stoppingEvent", "receiver", "publicationAuthority", "checkpointId"],
  "properties": {
    "task": { "$ref": "#/$defs/text" },
    "sourceAuthority": { "$ref": "#/$defs/text" },
    "budget": { "type": "integer", "minimum": 1, "maximum": 12 },
    "tools": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "inputProjection": { "$ref": "#/$defs/text" },
    "stoppingEvent": { "$ref": "#/$defs/text" },
    "receiver": { "$ref": "#/$defs/text" },
    "publicationAuthority": { "$ref": "#/$defs/text" },
    "checkpointId": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[\\p{L}\\p{N} .,:;_@/+\\-()]+$",
      "not": {
        "anyOf": [
          { "pattern": "\\b(?:[aA][pP][iI][ _-]?[kK][eE][yY]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN])\\s*:\\s*\\S+" },
          { "pattern": "\\b(?:[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]|[gG][hH][pPoOuUsSrR]|[sS][kK])_[\\p{L}\\p{N}_-]{8,}\\b" }
        ]
      }
    }
  }
}
