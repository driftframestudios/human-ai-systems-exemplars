{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vik.guru/visual-fidelity/component-lab/v1.schema.json",
  "title": "Visual Fidelity Component Lab Fixture",
  "description": "A closed fixture contract for the component lab's accepted catalog revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "componentLabId", "revision", "lineage", "catalog"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "componentLabId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "parentRevision"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
        "parentRevision": { "type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "catalog": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "$comment": "Runtime admission complements whole-item uniqueness by enforcing unique SKU values.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "label", "unitPriceCents", "stock"],
        "properties": {
          "sku": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
          "unitPriceCents": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "stock": { "type": "integer", "minimum": 0, "maximum": 100000 }
        }
      }
    }
  }
}
