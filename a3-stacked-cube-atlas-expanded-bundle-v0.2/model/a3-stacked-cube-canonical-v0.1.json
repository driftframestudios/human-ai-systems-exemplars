  "semantic_contract": {
    "cube_means": "a bounded software capability or service dependency; never a team, screen, or human activity merely because it appears in a workflow",
    "position_means": "current execution or decision authority only; position does not encode value, maturity, effort, safety, or priority",
    "migration_means": "a reversible routing and authority change through an explicit boundary, validation gate, and rollback route; it is not a copy animation",
    "coupling_rule": "visible gaps imply verified separability; coupled or unknown items remain banded, linked, or retained",
    "human_work_rule": "curator activities remain a human-workflow ribbon unless a bounded software capability has been separately evidenced",
    "unknown_rule": "UNKNOWN is a durable state that stays visible; it is never rendered as an empty or negative state",
    "historical_anchor": "the operational and assignment layer is the first safe, high-value candidate; scientific and regulatory business logic remains legacy unless evidence clears the gate",
    "color_rule": "color is paired with text, shape, hatch, and line style; color never carries authority state alone"
  },
