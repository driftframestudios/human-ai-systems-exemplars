{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repository-handoff-foundation:schema:foundation-manifest:v0.1",
  "title": "Repository handoff foundation manifest v0.1",
  "description": "A closed contract for source files that a repository handoff foundation can place or reconcile in a receiving repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "artifactType",
    "key",
    "version",
    "defaultProfileKey",
    "schemas",
    "modules",
    "entries",
    "issueSeeds"
  ],
  "properties": {
    "$schema": {
      "const": "./schema/foundation-manifest.schema.v0.1.json"
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "artifactType": {
      "const": "repository_handoff_foundation_manifest"
    },
    "key": {
      "$ref": "#/$defs/stableKey"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "defaultProfileKey": {
      "$ref": "#/$defs/stableKey"
    },
    "schemas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/schemaAuthority"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "issueSeeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/issueSeed"
      }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![^/]{256})(?!.*\\/[^/]{256})(?!.*(?:^|\\/)(?:\\.|\\.\\.)(?:\\/|$))(?!.*(?:^|\\/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))(?!.*\\.(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schemaAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "sourcePath",
        "id",
        "sha256"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "sourcePath": {
          "$ref": "#/$defs/portablePath"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^urn:repository-handoff-foundation:schema:[a-z0-9-]+:v0\\.1$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "description"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership": {
                "const": "foundation_generator"
              }
            },
            "required": [
              "ownership"
            ]
          },
          "then": {
            "properties": {
              "verificationPolicy": {
                "const": "exact_bytes"
              }
            }
          }
        }
      ],
      "required": [
        "key",
        "moduleKey",
        "sourcePath",
        "targetPath",
        "profiles",
        "activationCondition",
        "ownership",
        "collisionPolicy",
        "verificationPolicy",
        "sha256"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "moduleKey": {
          "$ref": "#/$defs/stableKey"
        },
        "sourcePath": {
          "$ref": "#/$defs/portablePath"
        },
        "targetPath": {
          "$ref": "#/$defs/portablePath"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableKey"
          }
        },
        "activationCondition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ownership": {
          "enum": [
            "foundation_generator",
            "receiving_owner"
          ]
        },
        "collisionPolicy": {
          "enum": [
            "create_if_absent",
            "preserve_and_report"
          ]
        },
        "verificationPolicy": {
          "enum": [
            "exact_bytes",
            "present_regular_file"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "issueSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "sourcePath",
        "profiles",
        "sha256"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "sourcePath": {
          "$ref": "#/$defs/portablePath"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableKey"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
