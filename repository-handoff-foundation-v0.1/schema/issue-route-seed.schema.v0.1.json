{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repository-handoff-foundation:schema:issue-route-seed:v0.1",
  "title": "Repository handoff Issue route seed v0.1",
  "description": "A semantic-keyed bootstrap and recovery contract for labels, milestones, Issues, typed relations, acceptance, authority, and next receivers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "artifactType",
    "key",
    "title",
    "currentFrontKey",
    "materializationPolicy",
    "labels",
    "milestones",
    "relationTypes",
    "issues",
    "relations",
    "projection"
  ],
  "properties": {
    "$schema": {
      "const": "../schema/issue-route-seed.schema.v0.1.json"
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "artifactType": {
      "const": "repository_handoff_issue_route_seed"
    },
    "key": {
      "$ref": "#/$defs/stableKey"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "currentFrontKey": {
      "$ref": "#/$defs/stableKey"
    },
    "materializationPolicy": {
      "$ref": "#/$defs/materializationPolicy"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "relationTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/relationType"
      }
    },
    "issues": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "projection": {
      "$ref": "#/$defs/projection"
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![^/]{256})(?!.*\\/[^/]{256})(?!.*(?:^|\\/)(?:\\.|\\.\\.)(?:\\/|$))(?!.*(?:^|\\/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))(?!.*\\.(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relationTypeKey": {
      "enum": [
        "prepares",
        "receives",
        "runs_alongside"
      ]
    },
    "materializationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveIssueAuthorityAfterMaterialization",
        "existingIssuePolicy",
        "linkResolution"
      ],
      "properties": {
        "liveIssueAuthorityAfterMaterialization": {
          "const": true
        },
        "existingIssuePolicy": {
          "const": "preserve_and_report"
        },
        "linkResolution": {
          "const": "two_pass"
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "color",
        "description"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "description"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "relationType": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "prepares"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "inverseType": {
                "const": "receives"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "receives"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "inverseType": {
                "const": "prepares"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "runs_alongside"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "inverseType": {
                "const": "runs_alongside"
              }
            }
          }
        }
      ],
      "required": [
        "key",
        "inverseType",
        "description"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/relationTypeKey"
        },
        "inverseType": {
          "$ref": "#/$defs/relationTypeKey"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "statement"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "owner",
        "state",
        "statement"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "owner": {
          "$ref": "#/$defs/stableKey"
        },
        "state": {
          "enum": [
            "active",
            "held"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "nextReceiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "condition"
      ],
      "properties": {
        "type": {
          "enum": [
            "issue",
            "owner",
            "external"
          ]
        },
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "bodySource",
        "bodySha256",
        "labels",
        "milestoneKey",
        "acceptance",
        "authority",
        "nextReceiver"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bodySource": {
          "$ref": "#/$defs/portablePath"
        },
        "bodySha256": {
          "$ref": "#/$defs/sha256"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableKey"
          }
        },
        "milestoneKey": {
          "$ref": "#/$defs/stableKey"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "authority": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/authority"
          }
        },
        "nextReceiver": {
          "$ref": "#/$defs/nextReceiver"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "fromIssueKey",
        "type",
        "toIssueKey",
        "condition",
        "inverseRelationKey"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "fromIssueKey": {
          "$ref": "#/$defs/stableKey"
        },
        "type": {
          "$ref": "#/$defs/relationTypeKey"
        },
        "toIssueKey": {
          "$ref": "#/$defs/stableKey"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "inverseRelationKey": {
          "$ref": "#/$defs/stableKey"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "jsonSource",
        "yamlTarget",
        "mode",
        "derivationNote"
      ],
      "properties": {
        "authority": {
          "const": "json"
        },
        "jsonSource": {
          "$ref": "#/$defs/portablePath"
        },
        "yamlTarget": {
          "$ref": "#/$defs/portablePath"
        },
        "mode": {
          "const": "exact_json_bytes"
        },
        "derivationNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
